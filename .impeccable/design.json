  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The single primary action of a view, such as Verify.",
      "html": "<button class=\"ds-btn ds-btn-primary\">Verify</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;gap:8px;min-height:38px;padding:7px 16px;border-radius:6px;border:1px solid var(--line-strong,#b8c5c8);background:var(--surface,#fff);color:var(--ink,#1b2326);font:600 1rem/1.5 var(--font,system-ui);cursor:pointer;transition:background-color 150ms ease,border-color 150ms ease,transform 150ms cubic-bezier(0.23,1,0.32,1)}.ds-btn:active{transform:scale(0.97)}.ds-btn:focus-visible{outline:2px solid var(--focus,#146a78);outline-offset:2px}.ds-btn-primary{background:var(--accent,#146a78);border-color:var(--accent,#146a78);color:var(--accent-ink,#fff)}.ds-btn-primary:hover{background:var(--accent-hover,#0f5966);border-color:var(--accent-hover,#0f5966)}"
    },
    {
      "name": "Default Button",
      "kind": "button",
      "refersTo": "button-default",
      "description": "Secondary actions on a white board.",
      "html": "<button class=\"ds-btn\">Write and download CSV</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;gap:8px;min-height:38px;padding:7px 16px;border-radius:6px;border:1px solid var(--line-strong,#b8c5c8);background:var(--surface,#fff);color:var(--ink,#1b2326);font:600 1rem/1.5 var(--font,system-ui);cursor:pointer;transition:border-color 150ms ease,transform 150ms cubic-bezier(0.23,1,0.32,1)}.ds-btn:hover{border-color:var(--ink-3,#6b7a80)}.ds-btn:active{transform:scale(0.97)}.ds-btn:focus-visible{outline:2px solid var(--focus,#146a78);outline-offset:2px}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Form input with teal focus halo.",
      "html": "<label class=\"ds-field\"><span class=\"ds-label\">Reviewer</span><input class=\"ds-input\" placeholder=\"Initials\"></label>",
      "css": ".ds-field{display:grid;gap:4px;font-family:var(--font,system-ui)}.ds-label{font-size:0.875rem;font-weight:600;color:var(--ink,#1b2326)}.ds-input{min-height:38px;padding:7px 10px;border:1px solid var(--line-strong,#b8c5c8);border-radius:6px;background:var(--surface,#fff);color:var(--ink,#1b2326);font:inherit;transition:border-color 150ms ease,box-shadow 150ms ease}.ds-input:focus{outline:none;border-color:var(--accent,#146a78);box-shadow:0 0 0 3px var(--accent-soft,#e1f0f2)}"
    },
    {
      "name": "Sidebar Navigation",
      "kind": "nav",
      "refersTo": "nav-link-active",
      "description": "Petrol sign panel with white legends; current page raised with a pale-teal bar.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-nav-link\" aria-current=\"page\" href=\"#\">Cases</a><a class=\"ds-nav-link\" href=\"#\">Review queue<span class=\"ds-count\">4</span></a><a class=\"ds-nav-link\" href=\"#\">Audit trail</a></nav>",
      "css": ".ds-nav{background:var(--shell,#0f3a44);padding:20px 12px;display:flex;flex-direction:column;gap:2px;width:236px;font-family:var(--font,system-ui)}.ds-nav-link{position:relative;display:flex;align-items:center;gap:10px;padding:9px 12px;border-radius:6px;color:var(--shell-muted,#a9c5cb);text-decoration:none;transition:background-color 150ms ease,color 150ms ease}.ds-nav-link:hover{background:#ffffff12;color:var(--shell-ink,#f1f7f8)}.ds-nav-link:focus-visible{outline:2px solid var(--focus,#146a78);outline-offset:2px}.ds-nav-link[aria-current=page]{background:var(--shell-raised,#17505d);color:var(--shell-ink,#f1f7f8);font-weight:700}.ds-nav-link[aria-current=page]::before{content:'';position:absolute;left:0;top:8px;bottom:8px;width:3px;border-radius:2px;background:#8fd6e0}.ds-count{margin-left:auto;font-family:var(--mono,monospace);font-size:0.8125rem;background:var(--shell-line,#ffffff24);border-radius:999px;padding:0 8px;color:var(--shell-ink,#f1f7f8)}"
    },
    {
      "name": "Discrepancy Sign",
      "kind": "chip",
